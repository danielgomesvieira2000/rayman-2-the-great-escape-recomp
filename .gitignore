# ============================================================
#  NO GAME DATA IN THIS REPOSITORY. EVER.
#  Rayman 2 is Ubisoft's. This project ships tooling and
#  original code only; the user supplies their own ROM.
# ============================================================
*.z64
*.n64
*.v64
*.rom
baserom*
*.elf
*.o
*.obj
*.a
*.bin
*.sym
*.map

# Recompiler output (regenerated from the user's ROM)
/RecompiledFuncs/
/RecompiledPatches/
recomp_overlays.inl
funcs.h
dump.toml
data_dump.toml

# Recompiler executables produced by scripts/setup.*
/N64Recomp
/N64Recomp.exe
/RSPRecomp
/RSPRecomp.exe

# splat / disassembly output (derived from the user's ROM)
/asm/
/bin/
/expected/
/context/
/syms/*.toml

# Build trees
/build*/
/out/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
*.ninja
.ninja_deps
.ninja_log
compile_commands.json

# Tooling
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.user
Thumbs.db
desktop.ini
.DS_Store

# Read-only upstream checkouts used as reference (never built, never shipped)
/reference/

# Release staging
/dist/

# splat + link artifacts under recomp/ (regenerated from the user's own ROM by
# scripts/split-rom.sh and scripts/build-elf.sh). The hand-written splat config
# and the curated symbol_addrs.txt are committed; these are not.
/recomp/rayman2.us.ld
/recomp/undefined_funcs_auto.txt
/recomp/undefined_syms_auto.txt
/recomp/undefined_syms_extra.txt
